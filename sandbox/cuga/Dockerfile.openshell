# OpenShell variant of the CUGA image.
#
# Differences from Dockerfile.ubi (the operator image):
#   - entrypoint is cuga-entrypoint (not docker-entrypoint.sh)
#   - WORKDIR /sandbox (OpenShell supervisor requires a writable WORKDIR)
#   - no Playwright / Chromium (not needed in sandbox demo)
#   - no Postgres / CNPG integration
#
# Build context: repo root
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/python-312-minimal:latest
FROM ${BASE_IMAGE} AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:latest /uvx /usr/local/bin/uvx

ENV PATH="/usr/local/bin:$PATH"

USER root
WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/

RUN find src -name "*.egg-info" -o -name "build" -exec rm -rf {} + && \
    uv sync --frozen --no-editable --no-dev

# Slim down torch (saves ~143 MB)
RUN rm -rf /app/.venv/lib/python3.12/site-packages/torch/test \
           /app/.venv/lib/python3.12/site-packages/torch/include

# Strip debug symbols from native .so files
RUN find /app/.venv -type f \( -name "*.so" -o -name "*.so.*" \) \
      -exec strip --strip-unneeded {} \; 2>/dev/null || true

# Remove Python bytecode cache
RUN find /app/.venv -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM ${BASE_IMAGE}

USER root

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PATH="/usr/local/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./

# Runtime dependencies:
#   iproute   — `ip` command required by OpenShell supervisor (network namespace)
#   util-linux — `nsenter` required by OpenShell supervisor (network namespace)
#   tar       — required by the OpenShell gateway workspace-init container
#   sudo      — required to run nsenter as root from arbitrary non-root UIDs
RUN microdnf install -y iproute util-linux tar sudo && microdnf clean all

# Configure passwordless sudo for nsenter to allow non-root users to bridge ports to eth0
RUN echo "ALL ALL=(ALL) NOPASSWD: /usr/bin/nsenter" >> /etc/sudoers

# Workspace files baked in — seeded into writable /sandbox at runtime
RUN mkdir -p /app/cuga_workspace /sandbox/cuga_workspace && \
    chown -R 1001:0 /app/cuga_workspace /sandbox && \
    chmod -R g+rwX  /app/cuga_workspace /sandbox

COPY --from=builder --chown=1001:0 /app/.venv  /app/.venv
COPY --from=builder --chown=1001:0 /app/src    /app/src
COPY --chown=1001:0 \
    src/cuga/demo_tools/huggingface/contacts.txt \
    src/cuga/demo_tools/huggingface/cuga_knowledge.md \
    src/cuga/demo_tools/huggingface/cuga_playbook.md \
    src/cuga/demo_tools/huggingface/email_template.md \
    /app/cuga_workspace/
COPY --chown=1001:0 \
    sandbox/cuga/cuga-entrypoint.sh \
    /usr/local/bin/cuga-entrypoint
RUN chmod 0775 /app/.venv /app/src && \
    chmod 0775 /app/cuga_workspace/ && \
    chmod 0755 /usr/local/bin/cuga-entrypoint

USER root

ENV PATH="/app/.venv/bin:/usr/local/bin:$PATH" \
    CUGA_HOST=0.0.0.0 \
    DYNACONF_SERVER_PORTS__DEMO=7860 \
    CUGA_DBS_DIR=/tmp/cuga/dbs \
    CUGA_LOGGING_DIR=/tmp/cuga/logging \
    CUGA_FOLDER=/tmp/cuga/policies \
    FASTEMBED_CACHE_PATH=/tmp/cuga/fastembed \
    HF_HOME=/tmp/cuga/hf \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    UV_CACHE_DIR=/tmp/uv-cache

EXPOSE 7860

# OpenShell supervisor requires a writable WORKDIR for the sandbox identity.
WORKDIR /sandbox

CMD ["/usr/local/bin/cuga-entrypoint"]
